#!/bin/bash

show_help() {
    cat <<'EOF'
Usage: bs <command>

Commands:
  workflow    Run guided workflow
  capture     Create a Bootstrap Bundle from this Mac
  restore     Restore from a Bootstrap Bundle
  discover    Discover current Mac state
  blueprint   Configure restore selection
  preview     Preview planned changes
  compare     Compare selected environment with this Mac
  bootstrap   Apply selected configuration
  check       Check toolkit prerequisites
EOF
}

resolve_launcher_path() {
    local path="$1"
    local directory target

    while [[ -L "$path" ]]; do
        directory="$(cd "$(dirname "$path")" && pwd -P)" || return 1
        target="$(readlink "$path")" || return 1
        if [[ "$target" == /* ]]; then
            path="$target"
        else
            path="$directory/$target"
        fi
    done

    directory="$(cd "$(dirname "$path")" && pwd -P)" || return 1
    printf '%s/%s\n' "$directory" "$(basename "$path")"
}

case "${1:-}" in
    ""|help|--help|-h)
        show_help
        exit 0
        ;;
    workflow) mode=--workflow ;;
    capture) mode=--capture ;;
    restore) mode=--restore ;;
    discover) mode=--discover ;;
    blueprint) mode=--blueprint ;;
    preview) mode=--dry-run ;;
    compare) mode=--compare ;;
    bootstrap) mode=--bootstrap ;;
    check) mode=--check ;;
    *)
        printf 'Error: unknown command: %s\n\n' "$1" >&2
        show_help >&2
        exit 1
        ;;
esac

if [[ ( "$mode" == --restore && $# -ne 2 ) || ( "$mode" != --restore && $# -ne 1 ) ]]; then
    printf 'Error: expected %s\n\n' "$([[ "$mode" == --restore ]] && echo 'restore <bundle>' || echo 'one command')" >&2
    show_help >&2
    exit 1
fi

launcher_path="$(resolve_launcher_path "$0")" || {
    printf 'Error: failed to resolve the bs launcher location\n' >&2
    exit 1
}
toolkit_root="$(cd "$(dirname "$launcher_path")/.." && pwd -P)" || {
    printf 'Error: failed to resolve the Toolkit root\n' >&2
    exit 1
}

if [[ ! -x "$toolkit_root/bootstrap.sh" ]]; then
    printf 'Error: bootstrap.sh is unavailable at %s\n' "$toolkit_root" >&2
    exit 1
fi

if [[ "$mode" == --restore ]]; then
    case "$2" in
        /*) bundle_path="$2" ;;
        *) bundle_path="$PWD/$2" ;;
    esac
fi
cd "$toolkit_root" || exit 1
if [[ "$mode" == --restore ]]; then
    exec ./bootstrap.sh "$mode" "$bundle_path"
fi
exec ./bootstrap.sh "$mode"
